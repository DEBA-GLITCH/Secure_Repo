# ============================================================
# APP
# ============================================================
APP_ENV=development
SECRET_KEY=replace-this-with-a-random-64-char-string
#python -c "import secrets; print(secrets.token_hex(32))" --> generates a random 64-character hex string this is used for session management and other security features, so keep it secret!
FRONTEND_URL=http://localhost:3000

# ============================================================
# SUPABASE (your postgres)
# ============================================================
# get these from: supabase.com → your project → settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxx

# get this from: supabase.com → your project → settings → database → connection string
# IMPORTANT: choose "asyncpg" mode, not psycopg2
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379

# ============================================================
# GITHUB OAUTH
# ============================================================
# create at: github.com/settings/developers → OAuth Apps → New OAuth App
# app name: SecureRepo (dev)
# homepage: http://localhost:3000
# callback: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback

# ============================================================
# GROQ (fast analysis)
# ============================================================
# get from: console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL_FAST=llama-3.3-70b-versatile
GROQ_MODEL_FALLBACK=mixtral-8x7b-32768

# ============================================================
# OPENROUTER (deep reasoning)
# ============================================================
# get from: openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL_DEEP=deepseek/deepseek-r1:free
OPENROUTER_MODEL_ALT=qwen/qwen-2.5-72b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# files scoring above this threshold go to deep model (0.0 - 1.0)
LLM_DEEP_ANALYSIS_THRESHOLD=0.6

# ============================================================
# SCAN SETTINGS
# ============================================================
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_SCAN=1000
SCAN_JOB_TIMEOUT_SECONDS=300
CACHE_TTL_SECONDS=3600